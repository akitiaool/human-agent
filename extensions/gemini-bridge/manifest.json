{
  "manifest_version": 3,
  "name": "gemini-bridge",
  "version": "0.1.0",
  "description": "human-agent 与网页版 Gemini（AI Studio）之间的桥",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://aistudio.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
