{
  "manifest_version": 3,
  "name": "gemini-bridge",
  "version": "0.2.0",
  "description": "human-agent 与 AI Studio 网页版 Gemini 的桥（v2 网页对话驱动）：监控网页最新回复回传桥服务，长轮询取回填消息模拟人类输入。",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://aistudio.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
